rules_version = '2';

// BahinKo Firestore security rules.
// Deploy with: firebase deploy --only firestore:rules
//
// Rule of thumb: only members of a group (their uid is in memberIds) can
// see or change it. The one exception is joining: someone who knows the
// group's invite code may add themselves (and nothing else).
// Everything not allowed below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMemberOf(group) {
      return signedIn() && request.auth.uid in group.memberIds;
    }

    // Basic shape checks so a buggy or tampered app can't save junk.
    function validGroup(g) {
      return g.name is string && g.name.size() >= 3 && g.name.size() <= 40
        && g.createdBy is string
        && g.memberIds is list
        && g.members is list && g.members.size() <= 50;
    }

    // A normal edit by a member (e.g. adding a guest). Nobody can change
    // who created the group or which accounts are in it.
    function isMemberEdit() {
      return isMemberOf(resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.memberIds == resource.data.memberIds
        && validGroup(request.resource.data);
    }

    // Joining with an invite code. The ONLY allowed change is:
    //   * my uid appended to memberIds,
    //   * one member card appended to members, with my uid,
    //   * lastJoinCode set to the group's real invite code (proof I know it).
    function isJoining() {
      let before = resource.data;
      let after = request.resource.data;
      return signedIn()
        && !(request.auth.uid in before.memberIds)
        && after.diff(before).affectedKeys()
             .hasOnly(['memberIds', 'members', 'lastJoinCode'])
        && after.lastJoinCode == before.inviteCode
        && after.memberIds == before.memberIds.concat([request.auth.uid])
        && after.members.size() == before.members.size() + 1
        && after.members[after.members.size() - 1].id == request.auth.uid
        && after.members.size() <= 50;
    }

    match /groups/{groupId} {
      // Read: members only. (The app's "my groups" query filters by
      // memberIds array-contains my uid, which these rules require.)
      allow read: if isMemberOf(resource.data);

      // Create: you must be the creator and the only app-user member.
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && validGroup(request.resource.data);

      allow update: if isMemberEdit() || isJoining();

      // Delete: only the person who created the group.
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      // ----- Sub-collections: access comes from the parent group -----

      function group() {
        return get(/databases/$(database)/documents/groups/$(groupId)).data;
      }

      function isGroupMember() {
        return isMemberOf(group());
      }

      // Expenses: members only, with basic checks on the data.
      match /expenses/{expenseId} {
        allow read: if isGroupMember();
        allow create, update: if isGroupMember()
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 60
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents > 0
          && request.resource.data.shares is map;
        allow delete: if isGroupMember();
      }

      // Payments: any member can record one (e.g. "Yes, I paid").
      // Only the RECEIVER may mark it confirmed, unless the receiver is a
      // guest without the app (then any member can confirm for them).
      match /payments/{paymentId} {
        allow read: if isGroupMember();
        allow create: if isGroupMember()
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents > 0
          && request.resource.data.fromId != request.resource.data.toId
          && (request.resource.data.status == 'pending'
              || (request.resource.data.status == 'confirmed'
                  && (request.resource.data.toId == request.auth.uid
                      || !(request.resource.data.toId in group().memberIds))));
        allow update: if isGroupMember()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status'])
          && request.resource.data.status == 'confirmed'
          && (resource.data.toId == request.auth.uid
              || !(resource.data.toId in group().memberIds));
        allow delete: if isGroupMember()
          && resource.data.createdBy == request.auth.uid
          && resource.data.status == 'pending';
      }

      // Activity feed: members can add entries but never edit or delete
      // them, so the history stays honest.
      match /activity/{eventId} {
        allow read: if isGroupMember();
        allow create: if isGroupMember()
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 200;
      }

      // Recurring bills: members only.
      match /recurring/{billId} {
        allow read, write: if isGroupMember();
      }
    }

    // invites/{code} → which group a code belongs to.
    match /invites/{code} {
      // Look up ONE code you already know. Listing all codes is blocked,
      // so codes can't be harvested.
      allow get: if signedIn();
      allow list: if false;

      // Only a group's creator may publish its code, and only if the code
      // matches the group. getAfter() sees the group even when both are
      // written in the same batch.
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.inviteCode == code;

      // Re-publishing is allowed only for your own code (so another group
      // can never take over a code that's already in use).
      allow update: if signedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.groupId == resource.data.groupId;

      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
